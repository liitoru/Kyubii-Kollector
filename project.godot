; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Kyubii Kollector"
config/features=PackedStringArray("4.8", "Forward Plus")
config/icon="res://icon.svg"

[audio]

buses/default_bus_layout="uid://ddfqgmjcq7jlu"

[autoload]

Settings="*uid://nwvmhxhbx467"
ControllerIcons="*res://addons/controller_icons/ControllerIcons.gd"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor]

movie_writer/movie_file="G:/Gv/GameTest.ogv"
movie_writer/disable_vsync=true

[editor_plugins]

enabled=PackedStringArray("res://addons/controller_icons/plugin.cfg")

[file_customization]

folder_colors={
"res://Assets/": "blue",
"res://DevTextures/": "red",
"res://Globals/": "yellow",
"res://Maps/": "green",
"res://Models/": "purple",
"res://Scenes/": "pink",
"res://Scripts/": "orange",
"res://addons/": "gray",
"res://demo/": "gray"
}

[global_group]

Player=""

[gui]

common/auto_focus_strategy=1

